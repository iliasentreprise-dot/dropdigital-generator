{
  "redirects": [
    {
      "source": "/",
      "destination": "/generator.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/u/:slug",
      "destination": "/api/upsell-preview?slug=:slug"
    }
  ]
}
