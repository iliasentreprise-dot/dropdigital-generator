{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www\\.dropdigital\\.fr"
        }
      ],
      "destination": "https://dropdigital.fr/:path*",
      "permanent": true,
      "_ddCanonical": "www"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app\\.dropdigital\\.fr"
        }
      ],
      "destination": "https://dropdigital.fr/:path*",
      "permanent": true,
      "_ddCanonical": "app"
    },
    {
      "source": "/",
      "destination": "/generator.html",
      "permanent": false,
      "missing": [
        {
          "type": "host",
          "value": "(?<tenant>.+)\\\\.dropdigital\\\\.fr"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>[a-z0-9-]+)\\\\.dropdigital\\\\.fr"
        }
      ],
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/u/:slug",
      "destination": "/api/upsell-preview?slug=:slug"
    },
    {
      "source": "/v",
      "destination": "/preview.html"
    }
  ]
}
